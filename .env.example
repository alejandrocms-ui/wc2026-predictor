# ──────────────────────────────────────────────────────────────────────────
# wc2026-predictor configuration. Copy to `.env` and edit.
# THE APP RUNS WITH ZERO KEYS (Tier-0). Everything below is strictly additive.
# Never commit a real .env — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# --- General ---
WC2026_DATA_DIR=data
WC2026_LANG=es                 # default UI language: es | en
WC2026_RANDOM_SEED=20260611    # fixed seed for reproducible simulations
WC2026_N_SIMULATIONS=50000     # Monte Carlo draws (>=50000 recommended)
WC2026_DECAY_HALFLIFE_DAYS=547 # time-decay half-life for match weighting (~18 months)
WC2026_OFFLINE=false           # if true, never hit the network; use cached/seed data only

# --- Tier-1 (free tiers; optional, cached hard) ---
# football-data.org free API token (https://www.football-data.org/client/register)
WC2026_FOOTBALL_DATA_TOKEN=

# --- Tier-2 (paid; fully optional; degrade gracefully to Tier-0 if absent) ---
# API-Football / api-sports.io key (lineups, injuries, squads)
WC2026_API_FOOTBALL_KEY=

# --- LLM (OPTIONAL, cosmetic only) ---
# DeepSeek is an LLM, NOT a football-data source. If set, it only powers an
# optional plain-language "explain this prediction" blurb in the UI. It does
# NOT feed the statistical model. Leave blank to disable.
WC2026_DEEPSEEK_API_KEY=
